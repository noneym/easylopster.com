# --- Shared (web + gateway) ---
DATABASE_URL="mysql://user:pass@host:3306/easylopster"
REDIS_URL="redis://:pass@host:6379/0"
# 32 bytes, hex (64 chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Web ---
PORT=3000
# Internal URL the web app uses to reach the gateway's HTTP admin endpoint (health, node list)
GATEWAY_INTERNAL_URL="http://localhost:4000"
# Shared secret between web and gateway for internal HTTP calls
INTERNAL_SECRET=""
# Email verification (on when a mail transport is configured)
EMAIL_VERIFICATION="on"
# --- Mail (verification emails). Transport: cloudflare when CLOUDFLARE_EMAIL_* is set, else SMTP, else off
MAIL_MAILER="cloudflare"
MAIL_FROM="easylopster <no-reply@easylopster.com>"
CLOUDFLARE_EMAIL_ACCOUNT_ID=""
CLOUDFLARE_EMAIL_API_TOKEN=""
CLOUDFLARE_EMAIL_BASE_URL="https://api.cloudflare.com/client/v4"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="easylopster <no-reply@easylopster.com>"

# --- Gateway ---
GATEWAY_PORT=4000
# Public WebSocket URL nodes connect to
GATEWAY_WS_URL="ws://localhost:4000/ws"
# Workspace volume root (cloud workspaces live under <root>/<userId>/<botId>)
WORKSPACE_ROOT="./data/workspaces"

# --- Beta limits ---
BETA_MAX_BOTS=3
BETA_MAX_NODES=2
BETA_MAX_MCP=5
BETA_MAX_MESSAGES_PER_DAY=500
# Dev only: gateway pulls Telegram updates with getUpdates instead of webhooks
TELEGRAM_POLLING=0
# Cloud sandbox (exec tool): needs /var/run/docker.sock mounted into the gateway
SANDBOX_ENABLED=0
# BullMQ key prefix: keep "bull" in production; use e.g. "dev" locally when sharing the production Redis
QUEUE_PREFIX=bull
# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Brave Search for web_search (DuckDuckGo fallback otherwise)
BRAVE_API_KEY=

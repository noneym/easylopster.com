{
  "name": "@easylopster/node-desktop",
  "version": "1.11.0",
  "private": true,
  "description": "easylopster Node: a tray / menu-bar app that connects this computer (Windows or macOS) to your easylopster.com account.",
  "productName": "easylopster Node",
  "main": "dist/main.cjs",
  "author": "easylopster",
  "homepage": "https://easylopster.com",
  "scripts": {
    "build": "tsdown && node scripts/copy-renderer.mjs",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit",
    "dist:mac": "pnpm build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@easylopster/shared": "workspace:*",
    "@types/node": "^22.19.0",
    "easylopster-node": "workspace:*",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.easylopster.node",
    "productName": "easylopster Node",
    "artifactName": "easylopster-node-setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "noneym",
        "repo": "easylopster.com"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "shortcutName": "easylopster Node"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "artifactName": "easylopster-node-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "easylopster Node runs commands an agent asks for, after your approval."
      }
    },
    "dmg": {
      "title": "easylopster Node ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 550,
        "height": 380
      }
    }
  }
}

{
  "name": "@easylopster/node-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "easylopster Node for Windows: a tray app that connects this PC to your easylopster.com account.",
  "productName": "easylopster Node",
  "main": "dist/main.cjs",
  "author": "easylopster",
  "homepage": "https://easylopster.com",
  "scripts": {
    "build": "tsdown && node scripts/copy-renderer.mjs",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@easylopster/shared": "workspace:*",
    "@types/node": "^22.19.0",
    "easylopster-node": "workspace:*",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.easylopster.node",
    "productName": "easylopster Node",
    "artifactName": "easylopster-node-setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "shortcutName": "easylopster Node"
    }
  }
}
